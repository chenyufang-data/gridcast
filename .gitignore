githubtoken.txt

# python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# NYISO bytes are never committed: fetch-not-redistribute (see data/README.md)
data/cache/
data/*.csv
data/*.zip
data/processed/
# exported model bundles (derived weights, uploaded to the VM by hand)
data/models/

# runtime state
*.db
*.db-wal
*.db-shm

# regeneratable backtest outputs: per-day caches and slot-level results stay out;
# the small summary tables behind README numbers are committed
results/*
!results/default/
results/default/*
!results/default/summary.csv
!results/default/baselines_summary.csv
!results/default/imbalance_pooled.csv
!results/default/imbalance_by_zone.csv
!results/default/calibration.csv
