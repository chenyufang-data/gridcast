# environments and secrets
.venv/
.env
githubtoken.txt

# python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# NYISO bytes are never committed: fetch-not-redistribute (see data/README.md)
data/cache/
data/*.csv
data/*.zip
data/processed/

# runtime state
*.db
*.db-wal
*.db-shm

# regeneratable backtest outputs: per-day caches and slot-level results stay out;
# the small summary tables behind README numbers are committed
results/*
!results/default/
results/default/*
!results/default/summary.csv
!results/default/baselines_summary.csv
!results/default/imbalance_pooled.csv
!results/default/imbalance_by_zone.csv
!results/default/calibration.csv
!results/v1_w120/
results/v1_w120/*
!results/v1_w120/summary.csv
!results/v1_w120/baselines_summary.csv
!results/v1_w120/imbalance_pooled.csv
!results/v1_w120/imbalance_by_zone.csv
!results/v1_w120/calibration.csv
*.png

# editors / tooling
*.un~
*~
.claude/
