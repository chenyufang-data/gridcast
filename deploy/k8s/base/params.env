SCHEDULER_ENABLED=0
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
APP_DB_PATH=/data/app.db
NYISO_CACHE_DIR=/data/cache
WEATHER_PATH=/data/weather.csv
WEATHER_HOURLY_PATH=/data/weather_hourly.csv
WEATHER_REFRESH=1
MODEL_THREADS=2
RETENTION_MONTHS=24
WRITE_RATE_PER_MIN=30
WRITE_RATE_BURST=10
API_BASE=http://gridcast-api:8000
LLM_PROVIDER=none
CHAT_LIMIT_PER_USER_DAY=20
CHAT_LIMIT_GLOBAL_DAY=300
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
