# gridcast environment template. Copy to .env and fill in what you need:
#   cp .env.sample .env
# .env is excluded by .gitignore / .dockerignore. Never commit real secrets.

# --- Write access ------------------------------------------------------------
# Required by every write endpoint (POST/PATCH/DELETE) as the X-Admin-Token
# header. Reads are public. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Chat model (optional; without one the chat panel is the keyword guide) ----
# Provider: vertex (Gemini via Vertex AI, the deployed choice), github (GitHub Models
# free tier), none, or auto (vertex when VERTEX_PROJECT is set, else github when
# GITHUB_TOKEN is set, else none)
# LLM_PROVIDER=auto
# Vertex AI: no key file anywhere. On the GCE VM the SDK uses the VM's service account
# (grant it roles/aiplatform.user and enable the Vertex AI API); locally run
# `gcloud auth application-default login` once.
# VERTEX_PROJECT=my-gcp-project
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash-lite
# Daily request limits for the demo: per visitor (IP behind the proxy) and overall
# CHAT_LIMIT_PER_USER_DAY=20
# CHAT_LIMIT_GLOBAL_DAY=300
# GitHub Models free tier: fine-grained PAT with the "Models" permission
# GITHUB_TOKEN=
# GITHUB_MODELS_URL=https://models.github.ai/inference/chat/completions
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- Service addresses / storage (local defaults usually fine) ---------------
# Frontend -> backend URL (docker compose overrides to http://backend:8000)
# API_BASE=http://127.0.0.1:8000
# SQLite path, default data/app.db
# APP_DB_PATH=
# NYISO fetch cache (raw daily CSVs / monthly zips), default data/cache
# NYISO_CACHE_DIR=
# Weather caches (Open-Meteo day-ahead forecasts per zone), defaults data/weather.csv and
# data/weather_hourly.csv; delete the files to run without weather features
# WEATHER_PATH=
# WEATHER_HOURLY_PATH=
# Logging level for backend and scripts (DEBUG, INFO, WARNING)
# LOG_LEVEL=INFO

# --- Models (app/serving.py) ---------------------------------------------------
# The ONNX TFT bundle (tft.onnx + tft.json from scripts/export_tft.py), default
# data/models/tft locally and /data/models/tft in the image; missing/stale/rejected
# bundles fall back to the LightGBM trees, which train on demand
# TFT_BUNDLE_DIR=
# Bundle age (days since its fit cutoff) beyond which the trees take over
# TFT_MAX_AGE_DAYS=60
# Threads for LightGBM fits on the VM (e2-small has two shared vCPUs)
# MODEL_THREADS=2

# --- Scheduler and retention (app/scheduler.py, app/service.py) -----------------
# In-process daily jobs (ET wall clock); 0 disables the thread (tests, one-off runs)
# SCHEDULER_ENABLED=1
# SCHEDULE_FORECAST_ET=04:30      # weather refresh + partial load + forecast tomorrow
# SCHEDULE_INGEST_ET=06:30        # catch up every table, score yesterday, alerts
# SCHEDULE_ISOLF_ET=08:30         # tomorrow's ISO forecast + DA prices (posted ~07-08 ET)
# SCHEDULE_RETENTION_ET=07:00     # 1st of the month: prune past the retention window
# Months of market data kept on the VM (whole months; never below 14 = window + lags)
# RETENTION_MONTHS=24
# Open-Meteo refresh in the forecast job (0 = never touch the network for weather)
# WEATHER_REFRESH=1

# --- Write rate limit (per client IP / X-Forwarded-For) ------------------------
# WRITE_RATE_PER_MIN=30
# WRITE_RATE_BURST=10

# --- Production (docker-compose.prod.yml + Caddy, see deploy/RUNBOOK.md) -----
# Site address: a domain (auto-HTTPS) or :80 for a bare-IP demo
# SITE_ADDRESS=gridcast.cyfang.org
